# Local-only starter defaults. Copy to .env only if your launcher loads it.
AUDIO_LAB_HOST=127.0.0.1
AUDIO_LAB_PORT=4188
AUDIO_LAB_DATA_DIR=.data
AUDIO_LAB_TTS_MODE=fixture
AUDIO_LAB_MAX_TEXT_CHARS=40000

# Optional future private-reader publisher. Never commit real values.
AUDIO_LAB_PUBLISH_BASE_URL=https://YOUR_PRIVATE_READER.example.com
CLOUDFLARE_ACCESS_CLIENT_ID=REPLACE_IN_SECRET_STORE
CLOUDFLARE_ACCESS_CLIENT_SECRET=REPLACE_IN_SECRET_STORE
